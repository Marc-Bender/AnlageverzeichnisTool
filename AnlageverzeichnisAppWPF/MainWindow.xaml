<Window x:Class="AnlageverzeichnisAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
        mc:Ignorable="d"
        Title="Anlageverzeichnis" Height="450" Width="940"
        >
    <Window.InputBindings>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding ActivePageSaveCommand}" />
        <KeyBinding Key="N"
                    Modifiers="Control"
                    Command="{Binding ActivePageNewCommand}" />
        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{Binding ActivePageOpenCommand}" />
        <KeyBinding Key="E"
                    Modifiers="Control"
                    Command="{Binding ActivePageExistingCommand}" />
        <!-- F5 needs explicit empty-modifier because otherwise the hot key would not work (also "none" does not work either because it is not a valid modifier option) !-->
        <KeyBinding Key="F5"
                    Modifiers="" 
                    Command="{Binding ActivePageReloadCommand}" />
        <!-- F11 needs explicit empty-modifier because otherwise the hot key would not work (also "none" does not work either because it is not a valid modifier option) !-->
        <KeyBinding Key="F11"
                    Modifiers="" 
                    Command="{Binding ActivePageApplyCommand}" />
    </Window.InputBindings>

    <Grid>
        <Frame 
            x:Name="mainFrame"
            NavigationUIVisibility="Hidden"
        />
    </Grid>
</Window>
