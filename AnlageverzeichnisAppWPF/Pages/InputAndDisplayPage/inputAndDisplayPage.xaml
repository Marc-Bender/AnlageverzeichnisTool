<Page x:Class="AnlageverzeichnisAppWPF.inputAndDisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      Focusable="True"
      d:DesignHeight="600" d:DesignWidth="940"
      Title="Eingabe und Anzeigemaske">
    
    <Page.Resources>
        <local:CentsToEuroStringConverter x:Key="CentsToEuroString" />
        <local:TenthPctToPercentageString x:Key="TenthPctToPercentageString" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:BoolInverseToVisibilityConverter x:Key="InverseBoolVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <local:BoldHeadingsConverter x:Key="BoldHeadings" />
        <local:EditingToBackgroundConverter x:Key="EditingBackground" />
        <local:YearsTo0P1PctConverter x:Key="YearsTo0P1Pct" />
        <local:CanLeaveConverter x:Key="CanLeaveConverter" />
        <local:FirstYearItalicPreviousYearConverter x:Key="FirstYearItalicPreviousYearConverter" />
        <local:dateOfPurchaseConverter x:Key="DateOfPurchaseConverter" />

        <Binding x:Key="ExpertModeEnableState" Path="DataContext.IsExpertModeEnabled" RelativeSource="{RelativeSource AncestorType=Page}"/>

        <Style x:Key="editStyle"
            TargetType="TextBox">
            <Setter Property="Background">
                <Setter.Value>
                    <Binding Path="IsEditing" RelativeSource="{RelativeSource AncestorType=DataGridCell}" Converter="{StaticResource EditingBackground}" />
                </Setter.Value>
            </Setter>
            <Setter Property="IsReadOnly">
                <Setter.Value>
                    <Binding Path="IsEditing" RelativeSource="{RelativeSource AncestorType=DataGridCell}" Converter="{StaticResource InverseBool}" />
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <DataTemplate x:Key="SelectedHeadingTextboxTemplate">
            <Grid 
                Visibility="{Binding IsHeading, Converter={StaticResource BoolVisibility}}"
                >
                <Label
                        Content="*"
                        FontWeight="UltraBold"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsCurrentHeading, Converter={StaticResource BoolVisibility}}"
                        MouseLeftButtonDown="TextBox_MouseDown"
                />
                <Label
                        Content=" "
                        FontWeight="Normal"
                        Visibility="{Binding IsCurrentHeading, Converter={StaticResource InverseBoolVisibility}}"
                        MouseLeftButtonDown="TextBox_MouseDown"
                />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ObjectDescriptionTextTextBoxTemplate">
                <TextBox
                    Text="{Binding ObjectDescriptionText}"
                    FontWeight="{Binding IsHeading, Converter={StaticResource BoldHeadings}}"
                    Style="{StaticResource editStyle}"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                    />
        </DataTemplate>
        <DataTemplate x:Key="monthYearTextBoxTemplate">
            <TextBox
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                Style="{StaticResource editStyle}"
                PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
            >
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource DateOfPurchaseConverter}">
                        <Binding Path="MonthOfPurchase"/>
                        <Binding Path="YearOfPurchase"/>
                        <Binding Path="IsAggregatingPosition"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>
        <DataTemplate x:Key="priceAtPurchaseCentsTextBoxTemplate">
            <TextBox
                Text="{Binding PriceAtPurchase_Cents, Converter={StaticResource CentsToEuroString}}"
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                Style="{StaticResource editStyle}"
                PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                HorizontalContentAlignment="Right"
            />
        </DataTemplate>
        
        <DataTemplate x:Key="enterOrLeaveAmountCentsTextBoxTemplate">
            <TextBox
                Text="{Binding EnterOrLeaveAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                IsEnabled="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                Style="{StaticResource editStyle}"
                PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                HorizontalContentAlignment="Right"
            />
        </DataTemplate>
        
        <DataTemplate x:Key="accumulatedDeprecationCentsTextBoxTemplate">
            <Grid
                Visibility="{Binding IsLeavingThisYear, Converter={StaticResource InverseBoolVisibility}}"
                >
                <TextBox
                    Text="{Binding AccumulatedDepreciation_Cents, Converter={StaticResource CentsToEuroString}}"
                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                    IsEnabled="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                    Style="{StaticResource editStyle}"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                    HorizontalContentAlignment="Right"
                />
            </Grid>
        </DataTemplate>
        
        <DataTemplate x:Key="deprecationPercentageTextBoxTemplate">
            <Grid
                Visibility="{Binding IsLeavingThisYear, Converter={StaticResource InverseBoolVisibility}}"
                IsEnabled="{Binding IsAggregatingPosition, Converter={StaticResource InverseBool}}"
            >
                <TextBox
                    Text="{Binding DepreciationPercentage_0P1Pct, Converter={StaticResource TenthPctToPercentageString}}"
                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                    Style="{StaticResource editStyle}"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                    HorizontalContentAlignment="Right"
                />
            </Grid>
        </DataTemplate>
        
        <DataTemplate x:Key="currentYearDeprecationAmountCentsTextBoxTemplate">
            <Grid
                Visibility="{Binding IsLeavingThisYear, Converter={StaticResource InverseBoolVisibility}}"
                >
                <TextBox
                    Text="{Binding CurrentYearDepreciationAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                    IsEnabled="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                    Style="{StaticResource editStyle}"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                    HorizontalContentAlignment="Right"
                />
            </Grid>
        </DataTemplate>
    
        <DataTemplate x:Key="currentYearObjectValueTextBoxTemplate">
            <TextBox
                Text="{Binding CurrentYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                IsEnabled="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                Style="{StaticResource editStyle}"
                PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                HorizontalContentAlignment="Right"
            />
        </DataTemplate>
        
        <DataTemplate x:Key="previousYearObjectValueTextBoxTemplate">
            <TextBox
                Text="{Binding PreviousYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" 
                IsEnabled="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                Style="{StaticResource editStyle}"
                PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                HorizontalContentAlignment="Right"
            >
                <TextBox.FontStyle>
                    <MultiBinding Converter="{StaticResource FirstYearItalicPreviousYearConverter}">
                        <Binding Path="DataContext.Document.Header.CurrentlyWorkedOnYear" RelativeSource="{RelativeSource AncestorType=Page}"/>
                        <Binding Path="YearOfPurchase"/>
                    </MultiBinding>
                </TextBox.FontStyle>
            </TextBox>
        </DataTemplate>

        <Style x:Key="CanLeaveStyle"
            TargetType="CheckBox">
            <Setter Property="IsEnabled">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource CanLeaveConverter}">
                        <Binding Path="DataContext.Document.Header.CurrentlyWorkedOnYear" RelativeSource="{RelativeSource AncestorType=Page}"/>
                        <Binding Path="YearOfPurchase" />
                        <Binding Path="IsHeading" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        Margin="5"
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 1st row ## company name, zip code, city and year -->
        <Grid
            DataContext="{Binding Document.Header}"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox
                Name="companyNameTextBox"
                Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,5,0"
                IsEnabled="False"
                VerticalAlignment="Top"
            />
            <TextBox
                Name="companyCityAndZipCodeTextBox"
                Text="{Binding CompanyCityAndZipCode, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,5,0"
                IsEnabled="False"
                VerticalAlignment="Top"
            />
            <Grid
                Grid.Column="1"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Anlageverzeichnis für das Jahr"
                    Grid.Column="0"
                />
                <TextBox
                    Name="currentlyWorkedOnYearTextBox"
                    Text="{Binding CurrentlyWorkedOnYear, UpdateSourceTrigger=PropertyChanged}" 
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    IsEnabled="False" 
                    VerticalAlignment="Top"
                />
            </Grid>
            <Grid
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Grid.RowSpan="2"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button 
                    Name = "saveButton"
                    Content="Speichern (Strg+S)"
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Click="saveButton_Click"
                />
                <Button 
                    Name = "reloadButton"
                    Content="neu laden (F5)"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="5,0,0,5"
                    Click="reloadButton_Click"
                />
                <Button
                    x:Name="createPDFButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Content="exp. in PDF (Strg + P)"
                    Margin="5,0,0,5"
                    Click="createPDFButton_Click"
                />
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="0"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                    IsChecked="{Binding IsExpertModeEnabled}"
                    Content="Expertenmodus"    
                />
                <Button
                    x:Name="deleteRowsButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="Zeilen löschen"
                    Margin="5,0,0,0"
                    Click="deleteRowsButton_Click"
                />
                <Button
                    x:Name="recalculateRowsButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Content="Zeilen neu berechnen"
                    Margin="5,0,0,0"
                    Click="recalculateRowsButton_Click"
                />


            </Grid>
        </Grid>
        
        <!-- 2nd row ## data display -->
        <Grid
            Grid.Row="1"
            Margin="0,5,0,5"
            >
            <DataGrid 
                  Name="dataEntryLinesDataGrid"
                  ItemsSource="{Binding Document.DataEntryLines}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  CanUserResizeRows="False"
                  IsReadOnly="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="None"
                  PreviewKeyDown="dataEntryLinesDataGrid_PreviewKeyDown"
                  CellEditEnding="dataEntryLinesDataGrid_CellEditEnding"
                  SelectionChanged="dataEntryLinesDataGrid_RowEditEnding"
            >
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                <Setter Property="Background" Value="#FFFFB3B3"/>
                                <!-- light red -->
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- 0th column for the selector of the current heading -->
                    <DataGridTemplateColumn
                        Header="*"
                        CellTemplate="{StaticResource SelectedHeadingTextboxTemplate}"
                        IsReadOnly="True"
                    />
                    <!-- 1st column stretches -->
                    <DataGridTemplateColumn 
                        Header="Gegenstand"
                        Width="2.5*" 
                        CellTemplate="{StaticResource ObjectDescriptionTextTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource ObjectDescriptionTextTextBoxTemplate}"
                    />
                    <!-- Monat/Jahr combined -->
                    <DataGridTemplateColumn 
                        x:Name="purchaseDateDataGridColumn"
                        Header="MM/JJJJ" 
                        Width="0.7*"
                        CellTemplate="{StaticResource monthYearTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource monthYearTextBoxTemplate}"
                    />
                    <DataGridTemplateColumn 
                        x:Name="historicPriceDataGridColumn"
                        Header="€ Hist."
                        Width="*"
                        CellTemplate="{StaticResource priceAtPurchaseCentsTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource priceAtPurchaseCentsTextBoxTemplate}"
                    />

                    <DataGridTemplateColumn 
                        Header="€ Zu/Ab"
                        Width="*"
                        CellTemplate="{StaticResource enterOrLeaveAmountCentsTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource enterOrLeaveAmountCentsTextBoxTemplate}"
                    />

                    <DataGridTemplateColumn 
                        Header="€ Kum."
                        Width="1*"
                        CellTemplate="{StaticResource accumulatedDeprecationCentsTextBoxTemplate}"    
                        CellEditingTemplate="{StaticResource accumulatedDeprecationCentsTextBoxTemplate}"    
                    />


                    <DataGridTemplateColumn 
                        x:Name="percentageDeprecationDataGridColumn"
                        Header="% GJ Abschr."
                        Width="1.1*"
                        CellTemplate="{StaticResource deprecationPercentageTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource deprecationPercentageTextBoxTemplate}"
                    />

                    <DataGridTemplateColumn 
                        Header="€ GJ Abschr."
                        Width="*"
                        CellTemplate="{StaticResource currentYearDeprecationAmountCentsTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource currentYearDeprecationAmountCentsTextBoxTemplate}"
                    />

                    <DataGridTemplateColumn 
                        Header="€ Akt."
                        Width="*"
                        CellTemplate="{StaticResource currentYearObjectValueTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource currentYearObjectValueTextBoxTemplate}"
                    />

                    <DataGridTemplateColumn
                        Header="€ VJ"
                        Width="*"
                        CellTemplate="{StaticResource previousYearObjectValueTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource previousYearObjectValueTextBoxTemplate}"
                    />

                    <DataGridCheckBoxColumn
                            Header="Ü"
                            Width="0.25*"
                            Binding="{Binding IsHeading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />

                    <DataGridCheckBoxColumn
                            x:Name="isLeavingCheckBoxColumn"
                            Header="-"
                            Width="0.25*"
                            Binding="{Binding IsLeavingThisYear,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    >
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style BasedOn="{StaticResource CanLeaveStyle}" TargetType="CheckBox">
                                <Setter Property="ToolTip"
                                        Value="Ändungen hieran bedingen keine _direkte_ Werteänderung "
                                        >
                                </Setter>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn
                            Header="S"
                            Width="0.25*"
                            Binding="{Binding IsAggregatingPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        
        <!-- 3rd row ## data entry mask -->
        <Grid
            Name="dataEntryMaskGrid"
            Grid.Row="2"
            Margin="0,5,0,5"
            DataContext="{Binding CurrentlyEditedLine}"
            Visibility="{Binding DataContext.IsExpertModeEnabled, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolVisibility}}"
            IsEnabled="{Binding IsKeyboardFocusWithin, ElementName=dataEntryLinesDataGrid, Converter={StaticResource InverseBool}}"
            >
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Left"
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                >
                Gegenstandsbeschreibung
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                >
                Anschaffungs- <LineBreak/>
                monat
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                jahr
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="3"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                wert
            </TextBlock>
            <Grid
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                Grid.Row="0"
                Grid.Column="4"
                >
                <TextBlock
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    TextAlignment="Center"
                    Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource InverseBoolVisibility}}"
                    >
                    Abschreibungs- <LineBreak/>
                    prozentsatz
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    TextAlignment="Center"
                    Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource BoolVisibility}}"
                    >
                    Abschreibungs- <LineBreak/>
                    dauer [Jahre]
                </TextBlock>
            </Grid>
            <Button
                Name="applyLineButton"
                Grid.Row ="0"
                Grid.Column="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Eintrag übernehmen (F11,*)"
                Click="applyLineButton_Click"
            />
            <TextBox
                Name="objectDescriptionTextBox"
                Grid.Row="1"
                Grid.Column="0"
                Grid.RowSpan="4"
                Margin="0,0,5,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Visible"
                PreviewKeyDown="objectDescriptionTextBox_PreviewKeyDown"
                TabIndex="0"
                AcceptsReturn="True"
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                Text="{Binding ObjectDescriptionText, UpdateSourceTrigger=PropertyChanged}"
            />
            <xctk:IntegerUpDown
                Name="monthOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,5,0"
                Minimum="1"
                Maximum="12"
                Increment="1"
                PreviewKeyDown="monthOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="1"
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                IsEnabled ="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding MonthOfPurchase, UpdateSourceTrigger=PropertyChanged}"
            />
            <!--setting tabindex to -1 to make it not reachable by tab; this makes the next element after the month the purchase price and allows for a 
            even quicker navigation through the entry mask if the tab key is emulated with enter. explicitly need to handle the / key when in the month field to get to the year as intuitive replacement 
            in the offchance one needs to get there anyways -->
            <xctk:IntegerUpDown
                Name="yearOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,5,0"
                Minimum="1900"
                Maximum="{Binding DataContext.Document.Header.CurrentlyWorkedOnYear, RelativeSource={RelativeSource AncestorType=Page}}"
                Increment="1"
                PreviewKeyDown="yearOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="-1"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding YearOfPurchase, 
                        UpdateSourceTrigger=PropertyChanged}"
            />
            <TextBox
                Name="priceAtPurchaseTextBox"
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,0,5,0"
                PreviewKeyDown="priceAtPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                GotFocus="TextBox_GotFocus"
                PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                TabIndex="2"
                HorizontalContentAlignment="Right"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Text ="{Binding PriceAtPurchase_Cents, 
                        Converter={StaticResource CentsToEuroString},
                        UpdateSourceTrigger=PropertyChanged}"
                
            />
            <Grid
                Visibility="{Binding IsAggregatingPosition, Converter={StaticResource InverseBoolVisibility}}"
                Grid.Row="1"
                Grid.Column="4"
                >
                <TextBox
                    Name="deprecationPercentageTextBox"
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,0,5,0"
                    PreviewKeyDown="deprecationPercentageTextBox_PreviewKeyDown"
                    KeyDown="NumericTextBoxes_KeyDown"
                    GotFocus="TextBox_GotFocus"
                    PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                    TabIndex="3"
                    HorizontalContentAlignment="Right"
                    Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource InverseBoolVisibility}}"
                    IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                    Text="{Binding DepreciationPercentage_0P1Pct,
                           Converter={StaticResource TenthPctToPercentageString},
                           UpdateSourceTrigger=PropertyChanged}"
                />
                <xctk:IntegerUpDown
                    Name="deprecationYearsNumberBox"
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,0,5,0"
                    Minimum="1"
                    Maximum="100"
                    Increment="1"
                    PreviewKeyDown="deprecationYearsNumberBox_PreviewKeyDown"
                    KeyDown="NumericTextBoxes_KeyDown"
                    TabIndex="3"
                    Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource BoolVisibility}}"
                    IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                    Value="{Binding DepreciationPercentage_0P1Pct,
                            Converter={StaticResource YearsTo0P1Pct},
                            UpdateSourceTrigger=PropertyChanged}"
                />
            </Grid>

            <CheckBox
                Name="isHeadingCheckBox"
                Grid.Row="1"
                Grid.Column="5"
                Content="Nur Überschrift (F10)"
                TabIndex="4"
                IsChecked="{Binding IsHeading}"
                Checked="isHeadingCheckBox_Checked"
            />
            <CheckBox
                Name="isLeavingThisYearCheckBox"
                Grid.Row="2"
                Grid.Column="5"
                Content="Abgang in diesem Jahr (-)"
                TabIndex="5"
                IsChecked="{Binding IsLeavingThisYear}"
                Style="{StaticResource CanLeaveStyle}"
            >
            </CheckBox>

            <CheckBox
                Name="deprecationInYearsCheckBox"
                Grid.Row="3"
                Grid.Column="5"
                Content="Abschreibung in Jahren (F9)"
                TabIndex="6"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
            />
            
            <CheckBox
                Name="isAggregationPositionCheckBox"
                Grid.Row="4"
                Grid.Column="5"
                Content="ist Sammelposten? (F12)"
                TabIndex="6"
                IsChecked="{Binding IsAggregatingPosition}"
                Checked="isAggregationPositionCheckBox_Checked"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
            />
        </Grid>
        <!-- 3rd row ## Expert mode mask; only a "new entry" button because all entries can be done in the table... -->
        <Grid
            Grid.Row="2"
            Margin="0,5,0,5"
            Visibility="{Binding IsExpertModeEnabled, Converter={StaticResource BoolVisibility}}"
            >
            <Button
                Name="newEntryButton"
                Content="Neuer Eintrag (Strg+N)"
                Click="newEntryButton_Click"
            />
        </Grid>
    </Grid>
</Page>
