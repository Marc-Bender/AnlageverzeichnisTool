<Page x:Class="AnlageverzeichnisAppWPF.modeSelectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Hauptseite">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button 
            Grid.Column="0" 
            Margin="10" 
            Name="newButton" 
            Click="newButton_Click" 
            FontSize="18" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            Content="neu (Strg+N)"
        />

        <Button 
            Grid.Column="1" 
            Margin="10" 
            Name="newFromPreviousButton"
            Click="newFromPreviousButton_Click" 
            HorizontalAlignment="Stretch" 
            FontSize="18"
            VerticalAlignment="Stretch"
            Content="neu aus Vorjahr (Strg+E)"
        />

        <Button 
            Grid.Column="2" 
            Margin="10" 
            Name="loadButton" 
            Click="loadButton_Click" 
            FontSize="18"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            Content="existierendes laden (Strg+O)"
        />

    </Grid>
</Page>
