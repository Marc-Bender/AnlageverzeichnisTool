<Page x:Class="AnlageverzeichnisAppWPF.generalInformationInputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AnlageverzeichnisAppWPF" 
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      d:DesignHeight="420" d:DesignWidth="800"
      Title="Generelle Informationen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition> <!-- spacer -->
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <!-- 1st row -->
        <Label 
            Grid.Row="0" 
            Grid.Column="0" 
            Margin="3"
            VerticalAlignment="Center" 
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Right"
            >
            Firmenname
        </Label>
        <TextBox
            Name="companyNameTextBox"
            Grid.Row="0" 
            Grid.Column="1" 
            Margin="5"
            VerticalAlignment="Center"
            Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
            GotFocus="TextBoxes_GotFocus"
            />


        <!-- 2nd row -->
        <Label 
            Grid.Row="1" 
            Grid.Column="0" 
            Margin="3"
            VerticalAlignment="Center" 
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Right">
            Ort der Firma
        </Label>
        <TextBox 
            Name="companyCityAndZipCodeTextBox"
            Grid.Row="1" 
            Grid.Column="1" 
            Margin="5"
            VerticalAlignment="Center"
            Text="{Binding CompanyCityAndZipCode, UpdateSourceTrigger=PropertyChanged}"
            GotFocus="TextBoxes_GotFocus"
            />


        <!-- 3rd row -->
        <Label 
            Grid.Row="2" 
            Grid.Column="0" 
            Margin="3"
            VerticalAlignment="Center" 
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Right">
            Bearbeitetes Jahr
        </Label>
        <xctk:IntegerUpDown
                Name="monthOfPurchaseNumberBox"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                Minimum="1900"
                Maximum="2200"
                Increment="1"
                Value="{Binding CurrentlyWorkedOnYear, UpdateSourceTrigger=PropertyChanged}"
                HorizontalAlignment="Left"
                GotFocus="TextBoxes_GotFocus"
            />


        <!-- 4th row is spacer -->
        
        <!-- 5th row -->
        <Button
            Name="createButton"
            Content="anlegen"
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Click="createButton_Click"
        />

    </Grid>
</Page>
