<Window x:Class="AnlageverzeichnisAppWPF.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
        mc:Ignorable="d"
        Title="Bitte warten" Height="100" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            >
            Das PDF Dokument wird erstellt das kann einige Sekunden dauern.
        </TextBlock>
        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="Visible"
            />

    </Grid>
</Window>
