<Page x:Class="AnlageverzeichnisAppWPF.inputAndDisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="940"
      Title="Eingabe und Anzeigemakse">
    
    <Page.Resources>
        <local:CentsToEuroStringConverter x:Key="CentsToEuroString" />
        <local:TenthPctToPercentageString x:Key="TenthPctToPercentageString" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:BoolInverseToVisibilityConverter x:Key="InverseBoolVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <local:BoldHeadingsConverter x:Key="BoldHeadings" />
        <local:EditingToBackgroundConverter x:Key="EditingBackground" />
        <local:YearsTo0P1PctConverter x:Key="YearsTo0P1Pct" />
        
        <DataTemplate x:Key="HeadingCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding IsHeading, Mode=TwoWay}" 
                Click="CheckBox_Click"
            />
        </DataTemplate>
        <DataTemplate x:Key="IsLeavingThisYearCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding IsLeavingThisYear, Mode=TwoWay}" 
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                Click="CheckBox_Click"
            />
        </DataTemplate>
        <DataTemplate x:Key="DisplayAsMemorialValueCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding DisplayAsMemorialValue, Mode=TwoWay}" 
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                Click="CheckBox_Click"
            />
        </DataTemplate>
        <DataTemplate x:Key="ObjectDescriptionTextTextBoxTemplate">
                <TextBox
                    Text="{Binding ObjectDescriptionText}"
                    FontWeight="{Binding IsHeading, Converter={StaticResource BoldHeadings}}"
                    Background="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource EditingBackground}}"
                    BorderThickness="0"
                    IsHitTestVisible="True"
                    Focusable="True"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                    />
        </DataTemplate>
        <DataTemplate x:Key="monthYearTextBoxTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBox
                    Text="{Binding MonthOfPurchase}" 
                    Background="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource EditingBackground}}"
                    BorderThickness="0"
                    IsHitTestVisible="True"
                    Focusable="True"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                />
                <TextBlock
                    Text="/"
                />
                <TextBox
                    Text="{Binding YearOfPurchase}" 
                    Background="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource EditingBackground}}"
                    BorderThickness="0"
                    IsHitTestVisible="True"
                    Focusable="True"
                    PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid
        Margin="5"
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 1st row ## company name, zip code, city and year -->
        <Grid
            DataContext="{Binding Document.Header}"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox
                Name="companyNameTextBox"
                Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,5,0"
                IsEnabled="False"
                VerticalAlignment="Top"
            />
            <TextBox
                Name="companyCityAndZipCodeTextBox"
                Text="{Binding CompanyCityAndZipCode, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,5,0"
                IsEnabled="False"
                VerticalAlignment="Top"
            />
            <Grid
                Grid.Column="1"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Anlageverzeichnis für das Jahr"
                    Grid.Column="0"
                />
                <TextBox
                    Name="currentlyWorkedOnYearTextBox"
                    Text="{Binding CurrentlyWorkedOnYear, UpdateSourceTrigger=PropertyChanged}" 
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    IsEnabled="False" 
                    VerticalAlignment="Top"
                />
            </Grid>
            <Grid
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Grid.RowSpan="2"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button 
                    Name = "saveButton"
                    Content="Speichern (Strg+S)"
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Click="saveButton_Click"
                />
                <Button 
                    Name = "reloadButton"
                    Content="neu laden (F5)"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="5,0,0,5"
                    Click="reloadButton_Click"
                />
                <CheckBox
                    Grid.Row="1"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                    IsChecked="{Binding IsExpertModeEnabled}"
                    Content="Expertenmodus"    
                />
            </Grid>
        </Grid>
        
        <!-- 2nd row ## data display -->
        <Grid
            Grid.Row="1"
            Margin="0,5,0,5"
            >
            <DataGrid 
                  Name="dataEntryLinesDataGrid"
                  ItemsSource="{Binding Document.DataEntryLines}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  CanUserResizeRows="False"
                  IsReadOnly="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="None"
                  PreviewKeyDown="dataEntryLinesDataGrid_PreviewKeyDown"
            >
                <DataGrid.Columns>

                    <!-- 1st column stretches -->
                    <DataGridTemplateColumn 
                        Header="Gegenstand"
                        Width="2.5*" 
                        CellTemplate="{StaticResource ObjectDescriptionTextTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource ObjectDescriptionTextTextBoxTemplate}"
                        >

                    </DataGridTemplateColumn>

                    <!-- Monat/Jahr combined -->
                    <DataGridTemplateColumn 
                        Header="MM/JJJJ" 
                        Width="0.7*"
                        CellTemplate="{StaticResource monthYearTextBoxTemplate}"
                        CellEditingTemplate="{StaticResource monthYearTextBoxTemplate}"
                        >
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                        Header="€ Hist."
                        Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding PriceAtPurchase_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                        Header="€ Zu/Ab"
                        Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding EnterOrLeaveAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                            Header="€ Kum."
                            Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding AccumulatedDepreciation_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="% GJ Abschr."
                            Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding DepreciationPercentage_0P1Pct, Converter={StaticResource TenthPctToPercentageString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="€ GJ Abschr."
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding CurrentYearDepreciationAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="€ Akt."
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding CurrentYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="€ VJ"
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding PreviousYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="Ü"
                            Width="0.25*"
                            CellTemplate = "{StaticResource HeadingCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource HeadingCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="-"
                            Width="0.25*"
                            CellTemplate="{StaticResource IsLeavingThisYearCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource IsLeavingThisYearCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                            Header="E"
                            Width="0.25*"
                            CellTemplate="{StaticResource DisplayAsMemorialValueCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource DisplayAsMemorialValueCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        
        <!-- 3rd row ## data entry mask -->
        <Grid
            Name="dataEntryMaskGrid"
            Grid.Row="2"
            Margin="0,5,0,5"
            DataContext="{Binding CurrentlyEditedLine}"
            Visibility="{Binding IsExpertModeEnabled, Converter={StaticResource InverseBoolVisibility}}"
            IsEnabled="{Binding IsKeyboardFocusWithin, ElementName=dataEntryLinesDataGrid, Converter={StaticResource InverseBool}}"
            >
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Left"
                >
                Gegenstandsbeschreibung
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                monat
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                jahr
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="3"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                wert
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource InverseBoolVisibility}}"
                >
                Abschreibungs- <LineBreak/>
                prozentsatz
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource BoolVisibility}}"
                >
                Abschreibungs- <LineBreak/>
                dauer [Jahre]
            </TextBlock>
            <Button
                Name="applyLineButton"
                Grid.Row ="0"
                Grid.Column="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Eintrag übernehmen (F11,*)"
                Click="applyLineButton_Click"
            />
            <TextBox
                Name="objectDescriptionTextBox"
                Grid.Row="1"
                Grid.Column="0"
                Grid.RowSpan="4"
                Margin="0,0,5,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Visible"
                PreviewKeyDown="objectDescriptionTextBox_PreviewKeyDown"
                TabIndex="0"
                Text="{Binding ObjectDescriptionText, UpdateSourceTrigger=PropertyChanged}"
            />
            <xctk:IntegerUpDown
                Name="monthOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,5,0"
                Minimum="1"
                Maximum="12"
                Increment="1"
                PreviewKeyDown="monthOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="1"
                IsEnabled ="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding MonthOfPurchase, UpdateSourceTrigger=PropertyChanged}"
            />
            <!--setting tabindex to -1 to make it not reachable by tab; this makes the next element after the month the purchase price and allows for a 
            even quicker navigation through the entry mask if the tab key is emulated with enter. explicitly need to handle the / key when in the month field to get to the year as intuitive replacement 
            in the offchance one needs to get there anyways -->
            <xctk:IntegerUpDown
                Name="yearOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,5,0"
                Minimum="1900"
                Maximum="{Binding DataContext.Document.Header.CurrentlyWorkedOnYear, RelativeSource={RelativeSource AncestorType=Page}}"
                Increment="1"
                PreviewKeyDown="yearOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="-1"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding YearOfPurchase, 
                        UpdateSourceTrigger=PropertyChanged}"
            />
            <TextBox
                Name="priceAtPurchaseTextBox"
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,0,5,0"
                PreviewKeyDown="priceAtPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                GotFocus="TextBox_GotFocus"
                PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                TabIndex="2"
                HorizontalContentAlignment="Right"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Text ="{Binding PriceAtPurchase_Cents, 
                        Converter={StaticResource CentsToEuroString},
                        UpdateSourceTrigger=PropertyChanged}"
                
            />
            <TextBox
                Name="deprecationPercentageTextBox"
                Grid.Row="1"
                Grid.Column="4"
                Margin="0,0,5,0"
                PreviewKeyDown="deprecationPercentageTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                GotFocus="TextBox_GotFocus"
                PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                TabIndex="3"
                HorizontalContentAlignment="Right"
                Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource InverseBoolVisibility}}"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Text="{Binding DepreciationPercentage_0P1Pct,
                       Converter={StaticResource TenthPctToPercentageString},
                       UpdateSourceTrigger=PropertyChanged}"
            />
            <xctk:IntegerUpDown
                Name="deprecationYearsNumberBox"
                Grid.Row="1"
                Grid.Column="4"
                Margin="0,0,5,0"
                Minimum="1"
                Maximum="100"
                Increment="1"
                PreviewKeyDown="deprecationYearsNumberBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="3"
                Visibility="{Binding IsChecked, ElementName=deprecationInYearsCheckBox, Converter={StaticResource BoolVisibility}}"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding DepreciationPercentage_0P1Pct,
                        Converter={StaticResource YearsTo0P1Pct},
                        UpdateSourceTrigger=PropertyChanged}"
            />

            <CheckBox
                Name="isHeadingCheckBox"
                Grid.Row="1"
                Grid.Column="5"
                Content="Nur Überschrift (F10)"
                TabIndex="4"
                IsChecked="{Binding IsHeading}"
            />
            <CheckBox
                Name="isLeavingThisYearCheckBox"
                Grid.Row="2"
                Grid.Column="5"
                Content="Abgang in diesem Jahr (-)"
                TabIndex="5"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                IsChecked="{Binding IsLeavingThisYear}"
            />
            <CheckBox
                Name="displayAsMemorialValueCheckbox"
                Grid.Row="3"
                Grid.Column="5"
                Content="Auf Erinnerungswert setzen (E)"
                TabIndex="6"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                IsChecked="{Binding DisplayAsMemorialValue}"
            />
            <CheckBox
                Name="deprecationInYearsCheckBox"
                Grid.Row="4"
                Grid.Column="5"
                Content="Abschreibung in Jahren (F9)"
                TabIndex="6"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
            />
        </Grid>
        <!-- 3rd row ## Expert mode mask; only a "new entry" button because all entries can be done in the table... -->
        <Grid
            Grid.Row="2"
            Margin="0,5,0,5"
            Visibility="{Binding IsExpertModeEnabled, Converter={StaticResource BoolVisibility}}"
            >
            <Button
                Name="newEntryButton"
                Content="Neuer Entrag (Strg+N)"
                
            />
        </Grid>
    </Grid>
</Page>
