<Page x:Class="AnlageverzeichnisAppWPF.inputAndDisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AnlageverzeichnisAppWPF"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="940"
      Title="Eingabe und Anzeigemakse">
    
    <Page.Resources>
        <local:CentsToEuroStringConverter x:Key="CentsToEuroString" />
        <local:TenthPctToPercentageString x:Key="TenthPctToPercentageString" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:BoolInverseToVisibilityConverter x:Key="InverseBoolVisibility" />
        <local:BoldHeadingsConverter x:Key="BoldHeadings" />
        
        <DataTemplate x:Key="HeadingCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding IsHeading, Mode=TwoWay}" 
                Click="CheckBox_Click"
            />
        </DataTemplate>
        <DataTemplate x:Key="IsLeavingThisYearCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding IsLeavingThisYear, Mode=TwoWay}" 
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                Click="CheckBox_Click"
            />
        </DataTemplate>
        <DataTemplate x:Key="DisplayAsMemorialValueCheckBoxTemplate">
            <CheckBox 
                IsChecked="{Binding DisplayAsMemorialValue, Mode=TwoWay}" 
                Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}"
                Click="CheckBox_Click"
            />
        </DataTemplate>
    </Page.Resources>

    <Grid
        Margin="5"
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 1st row ## company name, zip code, city and year -->
        <Grid
            DataContext="{Binding Document.Header}"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox
                Name="companyNameTextBox"
                Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="0"
                Margin="0,0,5,0"
                IsEnabled="False"
            />
            <TextBox
                Name="companyCityAndZipCodeTextBox"
                Text="{Binding CompanyCityAndZipCode, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="1"
                Margin="0,0,5,0"
                IsEnabled="False"
            />
            <TextBox
                Name="currentlyWorkedOnYearTextBox"
                Text="{Binding CurrentlyWorkedOnYear, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Column="2"
                Margin="0,0,5,0"
                IsEnabled="False" 
            />
            <Button 
                Name = "saveButton"
                Content="Speichern (Strg+S)"
                Grid.Column="3"
                Click="saveButton_Click"
                Margin="0,0,5,0"
            />
            <Button 
                Name = "reloadButton"
                Content="neu laden (F5)"
                Grid.Column="4"
                Click="reloadButton_Click"
            />
        </Grid>
        
        <!-- 2nd row ## data display -->
        <Grid
            Grid.Row="1"
            Margin="0,5,0,5"
            >
            <!-- to be filled -->
            <DataGrid 
                  Name="dataEntryLinesDataGrid"
                  ItemsSource="{Binding Document.DataEntryLines}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  CanUserResizeRows="False"
                  IsReadOnly="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="None">
                <DataGrid.Columns>

                    <!-- 1st column stretches -->
                    <DataGridTemplateColumn 
                        Header="Gegenstand"
                        Width="2.5*" 
                        >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding ObjectDescriptionText}"
                                    FontWeight="{Binding IsHeading, Converter={StaticResource BoldHeadings}}"
                                />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- Monat/Jahr combined -->
                    <DataGridTemplateColumn Header="MM/JJ" Width="0.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MonthOfPurchase}" />
                                    <TextBlock Text="/"/>
                                    <TextBlock Text="{Binding YearOfPurchase}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                        Header="€ Hist."
                        Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding PriceAtPurchase_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                        Header="€ Zu/Ab"
                        Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding EnterOrLeaveAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                            Header="€ Kum."
                            Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding AccumulatedDepreciation_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="% GJ Abschr."
                            Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding DepreciationPercentage_0P1Pct, Converter={StaticResource TenthPctToPercentageString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="€ GJ Abschr."
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding CurrentYearDepreciationAmount_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="€ Akt."
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding CurrentYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="€ VJ"
                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding PreviousYearObjectValue_Cents, Converter={StaticResource CentsToEuroString}}"
                                    Visibility="{Binding IsHeading, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="Ü"
                            Width="0.25*"
                            CellTemplate = "{StaticResource HeadingCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource HeadingCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                            Header="-"
                            Width="0.25*"
                            CellTemplate="{StaticResource IsLeavingThisYearCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource IsLeavingThisYearCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                            Header="E"
                            Width="0.25*"
                            CellTemplate="{StaticResource DisplayAsMemorialValueCheckBoxTemplate}"
                            CellEditingTemplate="{StaticResource DisplayAsMemorialValueCheckBoxTemplate}"
                        >
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        
        <!-- 3rd row ## data entry mask -->
        <Grid
            Grid.Row="2"
            Margin="0,5,0,5"
            DataContext="{Binding CurrentlyEditedLine}"
            >
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Left"
                >
                Gegenstandsbeschreibung
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                monat
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                jahr
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="3"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Anschaffungs- <LineBreak/>
                wert
            </TextBlock>
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                TextAlignment="Center"
                >
                Abschreibungs- <LineBreak/>
                prozentsatz
            </TextBlock>
            <Button
                Name="applyLineButton"
                Grid.Row ="0"
                Grid.Column="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Eintrag übernehmen (F11,*)"
                Click="applyLineButton_Click"
            />
            <TextBox
                Name="objectDescriptionTextBox"
                Grid.Row="1"
                Grid.Column="0"
                Grid.RowSpan="3"
                Margin="0,0,5,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Visible"
                PreviewKeyDown="objectDescriptionTextBox_PreviewKeyDown"
                TabIndex="0"
                Text="{Binding ObjectDescriptionText, UpdateSourceTrigger=PropertyChanged}"
            />
            <xctk:IntegerUpDown
                Name="monthOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,5,0"
                Minimum="1"
                Maximum="12"
                Increment="1"
                PreviewKeyDown="monthOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="1"
                IsEnabled ="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding MonthOfPurchase, UpdateSourceTrigger=PropertyChanged}"
            />
            <!--setting tabindex to -1 to make it not reachable by tab; this makes the next element after the month the purchase price and allows for a 
            even quicker navigation through the entry mask if the tab key is emulated with enter. explicitly need to handle the / key when in the month field to get to the year as intuitive replacement 
            in the offchance one needs to get there anyways -->
            <xctk:IntegerUpDown
                Name="yearOfPurchaseNumberBox"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,5,0"
                Minimum="1900"
                Maximum="{Binding DataContext.Document.Header.CurrentlyWorkedOnYear, RelativeSource={RelativeSource AncestorType=Page}}"
                Increment="1"
                PreviewKeyDown="yearOfPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                TabIndex="-1"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Value="{Binding YearOfPurchase, 
                        UpdateSourceTrigger=PropertyChanged}"
            />
            <TextBox
                Name="priceAtPurchaseTextBox"
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,0,5,0"
                PreviewKeyDown="priceAtPurchaseTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                GotFocus="TextBox_GotFocus"
                PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                TabIndex="2"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Text ="{Binding PriceAtPurchase_Cents, 
                        Converter={StaticResource CentsToEuroString},
                        UpdateSourceTrigger=PropertyChanged}"
                
            />
            <TextBox
                Name="deprecationPercentageTextBox"
                Grid.Row="1"
                Grid.Column="4"
                Margin="0,0,5,0"
                PreviewKeyDown="deprecationPercentageTextBox_PreviewKeyDown"
                KeyDown="NumericTextBoxes_KeyDown"
                GotFocus="TextBox_GotFocus"
                PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                TabIndex="3"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                Text="{Binding DepreciationPercentage_0P1Pct,
                       Converter={StaticResource TenthPctToPercentageString},
                       UpdateSourceTrigger=PropertyChanged}"
            />
            <CheckBox
                Name="isHeadingCheckBox"
                Grid.Row="1"
                Grid.Column="5"
                Content="Nur Überschrift (F10)"
                TabIndex="4"
                IsChecked="{Binding IsHeading}"
            />
            <CheckBox
                Name="isLeavingThisYearCheckBox"
                Grid.Row="2"
                Grid.Column="5"
                Content="Abgang in diesem Jahr (-)"
                TabIndex="5"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                IsChecked="{Binding IsLeavingThisYear}"
            />
            <CheckBox
                Name="displayAsMemorialValueCheckbox"
                Grid.Row="3"
                Grid.Column="5"
                Content="Auf Erinnerungswert setzen (E)"
                TabIndex="6"
                IsEnabled="{Binding ElementName=isHeadingCheckBox, Path=IsChecked, Converter={StaticResource InverseBool}}"
                IsChecked="{Binding DisplayAsMemorialValue}"
            />
        </Grid>
    </Grid>
</Page>
